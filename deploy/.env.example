# nwbd-dev-workstation 本地配置模板
# 复制为 deploy/.env 后填写，.env 不进 git

# ---- 数据库 ----
POSTGRES_DB=dev_workstation
POSTGRES_USER=dev_workstation
POSTGRES_PASSWORD=请替换为口令

# ---- 钉钉登录（复用 nwbd-file-manage 的企业内部应用）----
DD_CLIENT_ID=
DD_CLIENT_SECRET=
DD_CORP_ID=

# 本系统对外地址：决定 Cookie 是否带 Secure、默认登录页地址
PUBLIC_BASE_URL=http://127.0.0.1:8090
# 扫码登录的 redirect_uri，必须与钉钉后台已登记的回调地址一致。
# 留空则用 PUBLIC_BASE_URL + /login（本地地址通常未登记，建议填已登记的域名）。
LOGIN_REDIRECT=http://127.0.0.1:8090/login

# ---- 运行参数 ----
NWBD_WS_ENVIRONMENT=local
NWBD_WS_LOG_LEVEL=INFO
# 本地开发登录（跳过钉钉）。仅当环境为 local 且这里非空时生效；线上留空即可。
DEV_LOGIN_USERID=
DEV_LOGIN_NAME=本地开发账号
# 本地测试：允许页头切换成任意在职人员。线上必须 false。
DEV_ACT_AS=true
NWBD_WS_CORS_ORIGINS=http://127.0.0.1:5175,http://localhost:5175
TOKEN_TTL_DAYS=30
ROLE_SYNC_MINUTES=10
# 通讯录全量同步间隔（分钟）
DIRECTORY_SYNC_MINUTES=30

# ---- 文件管理（nwbd-file-manage）内部接口 ----
# api 容器需加入 docker 网络 nwbd-link-files-dev，用容器名直连
FILE_MANAGE_BASE=http://nwbd-fm-api:8000
# 与文件管理 deploy/.env 里的 NWBD_FM_INTERNAL_TOKEN 保持一致
FILE_MANAGE_TOKEN=
# 单文件上限（MB），与文件管理保持一致
MAX_UPLOAD_MB=100

# 线上技能库（nwbd-skills）
SKILLS_BASE=http://8.160.178.247:18138

# ---- 构建期镜像源（国内网络）----
GO_PROXY=https://goproxy.cn,direct
ALPINE_MIRROR=https://mirrors.aliyun.com/alpine
NPM_REGISTRY=https://registry.npmmirror.com
